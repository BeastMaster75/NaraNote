# Production settings for docker-compose.prod.yml. Copy to .env on the server
# (it's gitignored) and fill in every value — Compose refuses to start if any
# required one is missing. See docs/deployment.md.

# The site's address, without https:// or www. Point both naranote.net and
# www.naranote.net at the server; www redirects to this.
NARANOTE_DOMAIN=naranote.net

# Shown on the privacy page as the address for data requests and questions.
NARANOTE_CONTACT_EMAIL=

# Database. Generate the password with: openssl rand -base64 24
POSTGRES_USER=naranote
POSTGRES_PASSWORD=

# Encrypts users' saved Gemini keys. Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: losing it makes every saved key unreadable, and
# a database backup is useless for those keys without it.
NARANOTE_ENCRYPTION_KEY=

# Outgoing mail (verification and password-reset links). Any SMTP provider
# with STARTTLS on port 587 works. FROM must be an address on a domain the
# provider is allowed to send for, or mail will be rejected or land in spam.
NARANOTE_MAIL_HOST=
NARANOTE_MAIL_PORT=587
NARANOTE_MAIL_USERNAME=
NARANOTE_MAIL_PASSWORD=
NARANOTE_MAIL_FROM=NaraNote <no-reply@naranote.net>

# Optional: Sign in with Google. Create an OAuth client ("Web application") in
# the Google Cloud console, with authorised redirect URI
# https://<NARANOTE_DOMAIN>/api/auth/google/callback. Left empty, the button is
# hidden and everything else works.
NARANOTE_GOOGLE_CLIENT_ID=
NARANOTE_GOOGLE_CLIENT_SECRET=

# Optional: days of nightly database backups to keep in ./backups.
# NARANOTE_BACKUP_KEEP_DAYS=14
